<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nova_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_gradient_header"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/app_name"
        app:titleCentered="true"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/white" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:visibility="visible">

            <View
                android:layout_width="@dimen/orb_size"
                android:layout_height="@dimen/orb_size"
                android:background="@drawable/bg_orb" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center"
                android:text="@string/empty_chat_title"
                style="@style/TextAppearance.Nova.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/empty_chat_subtitle"
                style="@style/TextAppearance.Nova.Body" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_md"
        android:background="@drawable/bg_input_bar">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_message"
            android:textColor="@color/nova_on_surface"
            android:textColorHint="@color/nova_muted"
            android:padding="@dimen/space_md"
            android:maxLines="4"
            android:inputType="textCapSentences|textMultiLine" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="@dimen/action_size"
            android:layout_height="@dimen/action_size"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_circle_accent"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/action_mic" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="@dimen/action_size"
            android:layout_height="@dimen/action_size"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_circle_primary"
            android:src="@drawable/ic_send"
            android:contentDescription="@string/action_send" />
    </LinearLayout>
</LinearLayout>

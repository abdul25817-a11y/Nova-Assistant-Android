<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="TextAppearance.Nova.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/nova_on_surface</item>
    </style>

    <style name="TextAppearance.Nova.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/nova_on_surface</item>
    </style>

    <style name="TextAppearance.Nova.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/nova_on_surface</item>
    </style>

    <style name="TextAppearance.Nova.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/nova_muted</item>
    </style>

    <style name="Widget.Nova.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/nova_card_stroke</item>
        <item name="cardBackgroundColor">@color/nova_surface</item>
        <item name="contentPadding">@dimen/space_lg</item>
    </style>
</resources>
